# --- Obrigatórias ---
# Gere valores longos e aleatórios: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ADMIN_TOKEN=troque-por-um-token-de-admin

# --- Banco ---
# Docker Compose (PostgreSQL). Use uma senha sem caracteres especiais (ela entra numa URL).
POSTGRES_PASSWORD=troque-esta-senha
# Rodando sem Docker, o padrão é SQLite local (ponto.db). Para outro banco:
# DATABASE_URL=sqlite:///./ponto.db

# --- Comprovante de ponto (obrigatórios para emitir o PDF) ---
EMPRESA_NOME=Clínica Exemplo Ltda
EMPRESA_CNPJ=00.000.000/0001-00
EMPRESA_ENDERECO=Rua Exemplo, 100, Centro, Belo Horizonte - MG
# EMPRESA_CEI_CAEPF_CNO=

# --- Assinatura do PDF (opcional) ---
# Para testes: python -m scripts.gerar_certificado_teste   (gera certs/teste.p12, senha "teste")
# Em produção: certificado ICP-Brasil (.p12/.pfx) no lugar do de teste.
# CERT_P12_PATH=certs/teste.p12
# CERT_P12_SENHA=teste

# --- Opcionais ---
# BASE_URL=http://192.168.0.10:8000
# TZ_CLINICA=America/Sao_Paulo
# QR_VALIDADE_SEGUNDOS=120
# COMPROVANTE_VALIDADE_HORAS=72
# SESSAO_FUNCIONARIO_MINUTOS=15   # duração do login no extrato
# PIN_MAX_TENTATIVAS=5            # erros de PIN permitidos...
# PIN_BLOQUEIO_MINUTOS=15         # ...antes de bloquear o funcionário por este tempo
